generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// NextAuth.js Required Models
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  // Entitlement fields
  reviewsPurchased Int     @default(0)
  reviewsUsed      Int     @default(0)
  freeReviewUsed   Boolean @default(false)

  // Relations
  accounts     Account[]
  sessions     Session[]
  testAttempts TestAttempt[]
  purchases    Purchase[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Test Catalog
// ============================================

model Test {
  id           String  @id @default(cuid())
  testType     String  // 'SAT' | 'ACT' | 'AP'
  name         String  // e.g. 'SAT Practice Test 4'
  slug         String  @unique // e.g. 'sat-test-4'
  pdfUrl       String
  answerPdfUrl String
  scoringPdfUrl String
  isActive     Boolean @default(true)

  modules  TestModule[]
  attempts TestAttempt[]
}

model TestModule {
  id            String @id @default(cuid())
  testId        String
  section       String // 'Reading & Writing' | 'Math'
  moduleNumber  Int    // 1 or 2
  questionCount Int    // 33 for RW, 27 for Math

  test      Test       @relation(fields: [testId], references: [id])
  questions Question[]

  @@unique([testId, section, moduleNumber])
}

model Question {
  id             String  @id @default(cuid())
  moduleId       String
  questionNumber Int
  questionType   String
  questionText   String
  answerChoices  String? // JSON: {"A": "...", "B": "...", "C": "...", "D": "..."}
  correctAnswer  String  // 'A'|'B'|'C'|'D' or numeric string for grid-in
  isGridIn       Boolean @default(false)
  hasFigure      Boolean @default(false)

  // Archimedes layer
  approach     String
  whyRight     String
  trapAnalysis String // JSON: {"A": {"name": "...", "explanation": "..."}, ...}
  patternTip   String

  module  TestModule      @relation(fields: [moduleId], references: [id])
  answers StudentAnswer[]

  @@unique([moduleId, questionNumber])
}

// ============================================
// Test Attempts & Answers
// ============================================

model TestAttempt {
  id          String    @id @default(cuid())
  userId      String
  testId      String
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Scores stored as ranges per official scoring guide
  rwRawScore    Int?
  mathRawScore  Int?
  rwScoreLower  Int?
  rwScoreUpper  Int?
  mathScoreLower Int?
  mathScoreUpper Int?
  totalLower    Int?
  totalUpper    Int?

  // Session state
  tutorSessionStarted   Boolean @default(false)
  tutorSessionCompleted Boolean @default(false)

  user          User                @relation(fields: [userId], references: [id])
  test          Test                @relation(fields: [testId], references: [id])
  answers       StudentAnswer[]
  conversations TutorConversation[]
}

model StudentAnswer {
  id            String @id @default(cuid())
  attemptId     String
  questionId    String
  studentAnswer String
  isCorrect     Boolean

  attempt  TestAttempt @relation(fields: [attemptId], references: [id])
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model TutorConversation {
  id        String   @id @default(cuid())
  attemptId String
  questionId String
  messages  String   // JSON: [{"role": "user"|"assistant", "content": "..."}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempt TestAttempt @relation(fields: [attemptId], references: [id])

  @@unique([attemptId, questionId])
}

// ============================================
// Payments & Entitlements
// ============================================

model Purchase {
  id               String   @id @default(cuid())
  userId           String
  stripeSessionId  String   @unique
  stripePaymentId  String?
  bundleTier       String   // 'starter' | 'standard' | 'full'
  reviewsGranted   Int      // 3, 5, or 10
  amountCents      Int      // 2900, 3900, or 5900
  status           String   // 'pending' | 'complete' | 'failed'
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
